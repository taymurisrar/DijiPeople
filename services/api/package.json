{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean:dist": "node -e \"const fs=require('fs'); for (const p of ['dist','tsconfig.build.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true,maxRetries:5,retryDelay:200})\"",
    "build": "npm run clean:dist && npm run prisma:generate && nest build",
    "precheck-types": "npm run check:prisma-client",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "free:port": "node ../../scripts/free-port.mjs 4000",
    "check:prisma-client": "node ../../scripts/check-prisma-client-fresh.mjs",
    "prestart:dev": "npm run check:prisma-client",
    "start:dev": "npm run free:port && npm run clean:dist && node --max-old-space-size=8192 ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "prestart:debug": "npm run check:prisma-client",
    "start:debug": "npm run free:port && npm run clean:dist && node --max-old-space-size=8192 ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node --max-old-space-size=448 dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:migrate:status": "prisma migrate status --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "prisma:seed": "prisma db seed --config prisma.config.ts",
    "seed:admin": "ts-node prisma/seed-admin.ts",
    "seed:system": "npm run seed:config",
    "seed:config": "ts-node prisma/seed-config.ts",
    "seed:verify": "ts-node prisma/verify-seed-config.ts",
    "seed:demo": "ts-node prisma/seed-demo.ts",
    "seed:demo:reset": "ts-node prisma/seed-demo-reset.ts",
    "seed:demo:reseed": "npm run seed:demo:reset && npm run seed:demo",
    "seed:payroll-flow": "ts-node prisma/seed-payroll-flow.ts",
    "seed:platform-workflows": "ts-node prisma/seed-platform-workflows.ts",
    "invoice:sample-pdf": "ts-node src/modules/super-admin/invoice-pdf.sample.ts",
    "seed:all": "npm run seed:admin && npm run seed:config && npm run seed:platform-workflows && npm run seed:demo && npm run seed:legal",
    "release": "npm run prisma:migrate:deploy && npm run seed:config && npm run seed:verify && npm run seed:admin",
    "backfill:default-views": "ts-node prisma/backfill-default-views.ts",
    "backfill:attendance": "ts-node prisma/backfill-attendance.ts",
    "backfill:workspace-domains": "ts-node prisma/backfill-workspace-domains.ts",
    "seed:legal": "ts-node prisma/seed-legal.ts",
    "legal:publish": "ts-node prisma/publish-legal.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/config": "*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "docx": "^9.7.1",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "htmlparser2": "^10.1.0",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.6",
    "stripe": "^22.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(htmlparser2|domelementtype|domhandler|domutils|dom-serializer|entities)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
