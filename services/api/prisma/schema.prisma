model PlanPrice {
  id                      String             @id @default(uuid())
  planId                  String
  billingCycle            BillingCycle
  billingModel            BillingModel       @default(PER_SEAT)
  billingInterval         BillingInterval    @default(MONTH)
  currency                String
  unitAmount              Decimal            @db.Decimal(12, 2)
  minimumSeats            Int                @default(1)
  maximumSeats            Int?
  includedSeats           Int                @default(0)
  effectiveFrom           DateTime           @default(now())
  effectiveTo             DateTime?
  version                 Int                @default(1)
  supersedesPriceId       String?
  stripeProductId         String?
  stripePriceId           String?            @unique
  stripeEnvironment       StripeEnvironment?
  stripeSyncStatus        StripeSyncStatus   @default(NOT_SYNCED)
  stripeActive            Boolean            @default(false)
  stripeUsageType         String?
  stripeRecurringInterval String?
  stripeVerifiedAt        DateTime?
  stripeVerificationError String?
  isActive                Boolean            @default(true)
  // Market scoping. Nullable because the expand phase must not invalidate
  // prices that existed before markets did — a null market means "not yet
  // scoped", and resolution treats it as unavailable for self-service rather
  // than as a wildcard. Failing closed is the point: an unscoped price must
  // not silently become purchasable in every country.
  marketId                String?
  publicationStatus       CommercialPublicationStatus @default(DRAFT)
  salesModel              CommercialSalesModel        @default(SELF_SERVICE)
  publishedAt             DateTime?
  publishedById           String?
  archivedAt              DateTime?
  // Set when this row was created by the legacy-pricing backfill rather than
  // authored in Admin, so the contract phase can tell generated rows from
  // deliberate ones. See docs/bugs/BUG-0027-*.md.
  backfilledFromLegacyAt  DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  createdById             String?
  updatedById             String?
  plan                    Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  market                  Market?            @relation(fields: [marketId], references: [id], onDelete: Restrict)
  subscriptions           Subscription[]
  promotions              Promotion[]
  supersedes              PlanPrice?         @relation("PlanPriceVersions", fields: [supersedesPriceId], references: [id], onDelete: SetNull)
  supersededBy            PlanPrice[]        @relation("PlanPriceVersions")

  @@index([planId])
  @@index([billingModel, billingInterval, currency, isActive])
  @@index([billingCycle, currency, isActive])
  @@index([stripePriceId])
  @@index([stripeSyncStatus, stripeEnvironment])
  @@index([effectiveFrom, isActive])
  @@index([supersedesPriceId])
  // The resolution path: plan + market + currency + interval, filtered by
  // publication, then ordered by effective date.
  @@index([planId, marketId, currency, billingInterval, publicationStatus])
  @@index([marketId])
  @@index([publicationStatus, effectiveFrom])
}

// A commercial market: which countries are served together, in which currency,
// under which legal and tax treatment, and whether anyone may buy there yet.
//
// This exists because country-to-currency was previously a literal table inside
// the shipped landing bundle (docs/bugs/BUG-0028-*.md), which meant opening a
// market was a frontend deploy and could not be audited. Commercial truth
// belongs in configuration that Admin governs.
//
// Not tenant-owned: markets are DijiPeople's own commercial configuration, not
// a per-tenant setting, so there is deliberately no tenantId here.
model Market {
  id                  String                      @id @default(uuid())
  code                String                      @unique
  name                String
  description         String?
  publicationStatus   CommercialPublicationStatus @default(DRAFT)
  launchStatus        MarketLaunchStatus          @default(PLANNED)
  // isEnabled and selfServiceEnabled are separate on purpose. A market can be
  // enabled for sales-assisted deals while self-service checkout stays closed
  // — which is the honest state for a market whose tax registration or legal
  // documents are not yet in place.
  isEnabled           Boolean                     @default(false)
  selfServiceEnabled  Boolean                     @default(false)
  defaultCurrency     String
  supportedCurrencies String[]
  // Deliberately nullable references rather than invented values. A market
  // with no configured tax profile or legal document set is a market that
  // must not claim one publicly.
  dataRegion          String?
  taxProfileRef       String?
  legalDocumentSetRef String?
  supportTierRef      String?
  sortOrder           Int                         @default(0)
  publishedAt         DateTime?
  publishedById       String?
  archivedAt          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  createdById         String?
  updatedById         String?
  countries           MarketCountry[]
  prices              PlanPrice[]

  @@index([publicationStatus, isEnabled, sortOrder])
  @@index([launchStatus])
}

// Country-to-market mapping. A country belongs to exactly one market, enforced
// by the unique constraint on countryCode — otherwise a visitor could resolve
// to two markets with different currencies and the answer would depend on row
// order.
model MarketCountry {
  id          String   @id @default(uuid())
  marketId    String
  countryCode String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
}

