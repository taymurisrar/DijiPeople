/// Where a customer came from, as a reporting dimension the platform owns.
///
/// ITEM-0008. Partner *attribution* — who gets paid — was already denormalised
/// onto the customer as `originatingPartnerId`, while *channel* was reachable
/// only by joining back through `sourceLead`. Two similar things treated
/// differently, so any report grouping customers by channel needed a join, and a
/// customer created without a lead had no channel at all.
///
/// The values are grounded in what the platform actually produces rather than
/// invented: `submitLead` writes exactly "Website" or "Partner Referral", a
/// customer created directly in admin has no lead, and `Lead.source` is
/// admin-editable free text — so anything unrecognised becomes OTHER rather than
/// being forced into a channel it may not belong to.
enum CustomerOriginChannel {
  WEBSITE
  PARTNER_REFERRAL
  /// Created directly in the admin console, with no originating lead.
  DIRECT
  /// The originating lead carried a source this platform does not issue.
  OTHER
}

// Why a visitor contacted DijiPeople. Deliberately distinct from which modules
// interest them (Lead.interestAreas): "pricing inquiry" and "attendance,
// payroll" answer different questions, and collapsing them loses the one Sales
// acts on first.
//
// Nullable on Lead: historical leads predate this field and no honest value can
// be inferred for them. UNKNOWN would assert that someone chose it.
enum LeadInquiryIntent {
  REQUEST_DEMO
  PRICING
  PRODUCT_FEATURES
  IMPLEMENTATION
  PAYROLL
  ATTENDANCE_INTEGRATION
  DATA_MIGRATION
  INTEGRATION
  PARTNERSHIP
  EXISTING_CUSTOMER_SUPPORT
  GENERAL
  OTHER
}

// How an organisation wants to work with DijiPeople.
//
// PartnerType ({ INDIVIDUAL, COMPANY }) is the contracting entity type and
// answers a different question entirely, so a referral partner and a reseller
// were previously indistinguishable in the data. This is the commercial
// relationship; PartnerType stays what it is.
enum PartnershipModel {
  REFERRAL
  RESELLER
  IMPLEMENTATION
  TECHNOLOGY
  STRATEGIC
  CONSULTANT
  OTHER
}

