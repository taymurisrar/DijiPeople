  department             Department?               @relation(fields: [departmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  ownerUser              User?                     @relation("OwnedTeams", fields: [ownerUserId], references: [id], onDelete: SetNull)
  defaultWorkSchedule    WorkSchedule?             @relation("TeamDefaultWorkSchedule", fields: [defaultWorkScheduleId], references: [id], onDelete: SetNull)
  holidayCalendar        HolidayCalendar?          @relation("TeamHolidayCalendar", fields: [holidayCalendarId], references: [id], onDelete: SetNull)
  employees              Employee[]
  members                TeamMember[]
  teamRoles              TeamRole[]
  fieldSecurityPolicies  FieldSecurityPolicyTeam[]
  attendanceDeviceScopes AttendanceDeviceScope[]

  @@unique([tenantId, key])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, teamType])
  @@index([tenantId, businessUnitId])
  @@index([tenantId, departmentId])
  @@index([tenantId, isActive])
  @@index([tenantId, defaultWorkScheduleId])
  @@index([tenantId, holidayCalendarId])
}

