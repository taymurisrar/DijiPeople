model Plan {
  id                    String               @id @default(uuid())
  tenantId              String?
  key                   String               @unique
  name                  String
  description           String?
  isActive              Boolean              @default(true)
  stripeProductId       String?              @unique
  isPublic              Boolean              @default(true)
  metadataJson          Json?
  // DEPRECATED — legacy plan-level pricing. PlanPrice is the authoritative
  // price. These three columns are retained only so already-deployed clients
  // and in-flight data keep working during the migration described in
  // docs/bugs/BUG-0027-*.md; nothing may read them to decide what a customer
  // pays. `legacyPricingMigratedAt` records when a plan's legacy values were
  // backfilled into PlanPrice, so the contract phase can prove zero live
  // consumers before the columns are dropped.
  monthlyBasePrice      Decimal              @default(0) @db.Decimal(12, 2)
  annualBasePrice       Decimal              @default(0) @db.Decimal(12, 2)
  currency              String               @default("USD")
  legacyPricingMigratedAt DateTime?
  publicationStatus     CommercialPublicationStatus @default(DRAFT)
  salesModel            CommercialSalesModel        @default(SELF_SERVICE)
  publishedAt           DateTime?
  publishedById         String?
  archivedAt            DateTime?
