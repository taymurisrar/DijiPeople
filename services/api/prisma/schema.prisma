/// A tenant's changes to one sidebar navigation entry.
///
/// The sidebar stays code-defined so a new module reaches every tenant without
/// a publish step. This table records only the deltas a tenant chose, which is
/// why every column beyond the identity is nullable or defaulted: a missing row
/// means "use the code default", and a row with a null column means "use the
/// code default for that one property".
///
/// `itemKey` is the code item's href, which is already unique and stable across
/// releases. Rows for hrefs that no longer exist are ignored at merge time
/// rather than deleted, so reverting a product change restores the override.
model TenantNavigationOverride {
  id              String   @id @default(uuid())
  tenantId        String
  itemKey         String
  isHidden        Boolean  @default(false)
  label           String?
  sortOrder       Int?
  /// CommandVisibilityRule[] — the same shape the runtime evaluates for tabs,
  /// form sections and commands, so a rule written here behaves identically.
  visibilityRules Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  updatedById     String?
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemKey])
  @@index([tenantId])
}

/// Organization-scoped overrides for tenant settings.
///
/// Mirrors TenantSetting but is keyed by organization, so one tenant can run
/// several organizations with their own branding. Resolution merges key by key:
/// a tenant row supplies the value unless the organization overrides that exact
/// key, which matches how the resolver already falls back to built-in defaults.
///
/// This is a separate table rather than a nullable organizationId on
/// TenantSetting because Postgres treats NULLs as distinct in unique indexes,
/// so a nullable scope column would silently allow duplicate tenant-level rows
/// and break the upsert path every settings category depends on.
model OrganizationSetting {
  id             String       @id @default(uuid())
  tenantId       String
  organizationId String
  category       String
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  updatedById    String?
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, organizationId, category, key])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, category])
}

