  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A hostname that points at one workspace.
///
/// Globally unique, so two tenants can never claim the same hostname — that
/// uniqueness is the whole security property, because hostname is what the
/// request arrives with and everything downstream trusts the tenant it resolves
/// to.
model TenantDomain {
  id                 String                         @id @default(uuid())
  tenantId           String
  /// Normalised: lowercase, no port, no trailing dot.
  domain             String                         @unique
  type               TenantDomainType               @default(SYSTEM_SUBDOMAIN)
  isPrimary          Boolean                        @default(false)
  verificationStatus TenantDomainVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  /// Legacy free-text TLS note. Superseded by `tlsStatus`; kept so the column's
  /// existing values are not destroyed by this change.
  sslStatus          String?
  tlsStatus          TenantDomainTlsStatus          @default(NOT_REQUIRED)
  /// Proof-of-control challenge for a CUSTOM domain. The customer publishes it
  /// as a DNS TXT record. Never issued for a SYSTEM subdomain, which DijiPeople
  /// already controls.
  verificationToken  String?
  verificationTokenIssuedAt DateTime?
  lastVerificationAttemptAt DateTime?
  verificationFailureReason String?
  disabledAt         DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  createdById        String?
  updatedById        String?
  tenant             Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type, isPrimary])
  @@index([tenantId, isPrimary])
  @@index([verificationStatus])
}

/// A customer's family of workspaces — production, UAT, sandbox.
///
/// Purely organisational. It exists so Platform Admin can say "these three are
/// the same product for the same customer" without implying that any of them can
/// see another's data. Nothing is inherited through this relation.
model TenantEnvironmentGroup {
  id                String          @id @default(uuid())
  customerAccountId String
  name              String
  description       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdById       String?
  updatedById       String?
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  tenants           Tenant[]

  @@unique([customerAccountId, name])
  @@index([customerAccountId])
}

/// One attempt at provisioning a tenant.
///
/// Provisioning was previously only observable through PlatformEvent rows, which
/// record that something happened but not which step of the sequence it was, how
/// long it took, or whether the remainder can safely be re-run. Operations needs
/// all three to answer "did provisioning succeed, and can I retry it?" — so the
/// run and its steps are first-class rows.
model TenantProvisioningRun {
  id             String                      @id @default(uuid())
  tenantId       String
  /// ONBOARDING for the original run, RETRY for an operator-initiated re-run.
  trigger        String                      @default("ONBOARDING")
  attempt        Int                         @default(1)
  status         TenantProvisioningRunStatus @default(RUNNING)
  startedAt      DateTime                    @default(now())
  completedAt    DateTime?
  durationMs     Int?
  failedStepKey  String?
  message        String?
  correlationId  String?
  requestedById  String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps          TenantProvisioningStep[]

  @@index([tenantId])
  @@index([tenantId, startedAt])
  @@index([status])
}

/// One step of a provisioning run.
///
/// `isRetryable` is the step's own property, not the run's: re-running domain
/// provisioning or a customization publish is idempotent, whereas re-running the
/// identity/billing transaction would double-create. A retry replays only the
/// steps that declare themselves safe.
model TenantProvisioningStep {
  id          String                       @id @default(uuid())
  tenantId    String
  runId       String
  key         String
  label       String
  sequence    Int
  status      TenantProvisioningStepStatus @default(PENDING)
  isRetryable Boolean                      @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  message     String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run         TenantProvisioningRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, key])
  @@index([tenantId])
  @@index([runId, sequence])
}

/// Which DijiPeople applications a tenant is entitled to run, on which release
/// channel, and how their updates are governed.
///
/// ApplicationRelease is the global artefact catalogue and stays global. This is
/// the per-tenant policy on top of it, so a production tenant can sit on STABLE
/// while a pilot tenant previews the next agent build.
model TenantAppAssignment {
  id                String                    @id @default(uuid())
  tenantId          String
  /// Matches ApplicationRelease.appKey.
  appKey            String
  isEnabled         Boolean                   @default(true)
  channel           ApplicationReleaseChannel @default(STABLE)
  updatePolicy      TenantAppUpdatePolicy     @default(AUTOMATIC)
  /// Set when updatePolicy is PINNED: the exact release this tenant must run.
  assignedReleaseId String?
  /// Version floor enforced for this tenant regardless of update policy.
  minimumVersion    String?
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdById       String?
  updatedById       String?
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedRelease   ApplicationRelease?       @relation(fields: [assignedReleaseId], references: [id], onDelete: SetNull)

  @@unique([tenantId, appKey])
  @@index([tenantId])
  @@index([appKey])
}

/// Immutable proof that a tenant erasure was requested and what became of it.
///
/// Deliberately has NO relation to Tenant. Erasure destroys the tenant row and
/// everything cascading from it, including that tenant's own audit log — a
/// receipt joined to the tenant would be destroyed alongside the thing it exists
/// to evidence. It holds identifiers, actors, reason and outcome counts only:
/// never tenant HR or business content.
model TenantErasureReceipt {
  id                   String              @id @default(uuid())
  /// Plain column, not a foreign key. The tenant it names no longer exists.
  tenantId             String
  tenantName           String
  tenantSlug           String
  tenantCode           String?
  customerAccountId    String?
  customerName         String?
  reason               String
  status               TenantErasureStatus @default(REQUESTED)
  requestedById        String?
  requestedByName      String?
  requestedByEmail     String?
  executedById         String?
  executedByName       String?
  requestedAt          DateTime            @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  durationMs           Int?
  /// Row counts per model, for evidence. Counts only — never row content.
  erasedRecordCounts   Json?
  /// Records deliberately detached and kept (agreements, support history).
  retainedRecordCounts Json?
  failureMessage       String?
  correlationId        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([tenantId])
  @@index([status, requestedAt])
  @@index([customerAccountId])
}

model CustomerAccount {
  id                         String                      @id @default(uuid())
  companyName                String
  /// Where this customer came from. See CustomerOriginChannel (ITEM-0008).
  ///
  /// Nullable because rows created before this existed cannot all be classified:
  /// the migration backfills every customer that has a lead to read from, and
  /// leaves the rest NULL rather than guessing DIRECT for a customer whose lead
  /// was deleted. NULL therefore means "not known", which is a different and
  /// more honest statement than "direct".
  originChannel              CustomerOriginChannel?
  legalCompanyName           String?
  registrationNumber         String?
  taxId                      String?
  primaryContactFirstName    String?
  primaryContactLastName     String?
  primaryContactEmail        String?
  primaryContactPhone        String?
  billingContactEmail        String?
  financeContactName         String?
  financeContactEmail        String?
  industry                   String?
  companySize                String?
  contactEmail               String
  contactPhone               String?
  country                    String
  stateProvince              String?
  city                       String?
  addressLine1               String?
  addressLine2               String?
  website                    String?
  estimatedEmployeeCount     Int?
  actualEmployeeCount        Int?
  selectedPlanId             String?
  preferredBillingCycle      BillingCycle?
  customPricingFlag          Boolean                     @default(false)
  discountApproved           Boolean                     @default(false)
  leadId                     String?
  originatingPartnerId       String?
  originatingReferralLinkId  String?
  referralCodeSnapshot       String?
  status                     CustomerAccountStatus       @default(LEAD)
  subStatus                  String?
  assignedToUserId           String?
  accountManagerUserId       String?
  primaryOwnerUserId         String?
  stripeCustomerId           String?
  isDemoData                 Boolean                     @default(false)
  demoBatchId                String?
  seedSource                 String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  assignedToUser             PlatformUser?               @relation("AssignedCustomerAccounts", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  accountManagerUser         PlatformUser?               @relation("ManagedCustomerAccounts", fields: [accountManagerUserId], references: [id], onDelete: SetNull)
  primaryOwnerUser           User?                       @relation("OwnedCustomerAccounts", fields: [primaryOwnerUserId], references: [id], onDelete: SetNull)
  tenants                    Tenant[]
  selectedPlan               Plan?                       @relation("SelectedCustomerPlan", fields: [selectedPlanId], references: [id], onDelete: SetNull)
  sourceLead                 Lead?                       @relation("LeadToCustomer", fields: [leadId], references: [id], onDelete: SetNull)
  originatingPartner         Partner?                    @relation("PartnerAttributedCustomers", fields: [originatingPartnerId], references: [id], onDelete: SetNull)
  originatingReferralLink    PartnerReferralLink?        @relation("ReferralLinkCustomers", fields: [originatingReferralLinkId], references: [id], onDelete: SetNull)
  contacts                   CustomerContact[]
  notes                      CustomerNote[]
  environmentGroups          TenantEnvironmentGroup[]
  onboardings                CustomerOnboarding[]
  contracts                  Contract[]
  supportCases               SupportCase[]
  payrollCostAllocationLines PayrollCostAllocationLine[]
  promotions                 Promotion[]

  // ITEM-0008 — commercial reports group customers by channel.
  @@index([originChannel])
  @@index([status])
  @@index([subStatus])
  @@index([assignedToUserId])
  @@index([accountManagerUserId])
  @@index([primaryOwnerUserId])
  @@index([leadId])
  @@index([originatingPartnerId])
  @@index([originatingReferralLinkId])
  @@index([selectedPlanId])
  @@index([isDemoData])
  @@index([demoBatchId])
}

