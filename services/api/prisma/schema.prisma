model Lead {
  id                     String                      @id @default(uuid())
  contactFirstName       String?
  contactLastName        String?
  fullName               String
  companyName            String
  workEmail              String
  phoneNumber            String?
  companyWebsite         String?
  // Nullable since Wave 3. Both were required, and the public contact form does
  // not ask for either — so it invented values ("General HR operations",
  // "Unknown") to satisfy the column, which is BUG-0021. A Lead now records
  // what the visitor actually said and nothing else.
  industry               String?
  companySize            String?
  country                String?
  stateProvince          String?
  city                   String?
  estimatedEmployeeCount Int?
  expectedGoLiveDate     DateTime?
  budgetExpectation      String?
  requirementsSummary    String?
  notes                  String?
  // Contracting identity. `country` above is the operating country captured at
  // capture time; `countryOfRegistration` is the legal jurisdiction the entity
  // contracts under, which is frequently different.
  legalCompanyName       String?
  registrationNumber     String?
  registeredAddress      String?
  countryOfRegistration  String?
  taxId                  String?
  authorizedSignerName   String?
  authorizedSignerTitle  String?
  authorizedSignerEmail  String?
  billingContactName     String?
  billingContactEmail    String?
  // Confirmed commercial terms. The discovery fields above (interestedPlan,
  // estimatedEmployeeCount, budgetExpectation, expectedGoLiveDate) stay as
  // captured; these carry what both sides actually agreed to.
  agreedPlanId           String?
  agreedSeats            Int?
  agreedPrice            Decimal?                    @db.Decimal(12, 2)
  billingCycle           BillingCycle?
  subscriptionTerm       String?
  paymentTerms           String?
  proposedEffectiveDate  DateTime?
  assignedToUserId       String?
  partnerId              String?
  partnerReferralLinkId  String?
  referralCodeSnapshot   String?
  referralSource         String?
  referredAt             DateTime?
  attributionStatus      LeadAttributionStatus       @default(DIRECT)
  subStatus              String?
  isQualified            Boolean                     @default(false)
  convertedAt            DateTime?
  message                String?
  interestedPlan         String?
  // Why they got in touch, and which capabilities they named. Separate on
  // purpose — see LeadInquiryIntent.
  inquiryIntent          LeadInquiryIntent?
  interestAreas          String[]
  // Acquisition attribution, captured rather than typed by the visitor. All
  // nullable: an absent UTM parameter means the visitor arrived without one,
  // and inventing a value would corrupt campaign reporting.
  sourcePage             String?
  referrerUrl            String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  utmTerm                String?
  marketCode             String?
  correlationId          String?
  // Privacy notice acknowledgement and marketing consent, deliberately separate
  // columns. Acknowledging that we will process an inquiry is not agreement to
  // be marketed to, and storing one boolean for both makes the distinction
  // unrecoverable. Versioned now so the Wave 4 legal-document system can adopt
  // these without a data migration.
  privacyNoticeVersion   String?
  privacyNoticeAcceptedAt DateTime?
  marketingConsent       Boolean                     @default(false)
  marketingConsentAt     DateTime?
  marketingConsentWithdrawnAt DateTime?
  // Transport-duplicate guard. Mirrors PartnerInquiry.submissionHash, which
  // already solved this. Scoped to a short window by the hash input, so a
  // genuine repeat inquiry months later is still a new Lead.
  submissionHash         String?                     @unique
  source                 String
  status                 LeadStatus                  @default(NEW)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  assignedToUser         PlatformUser?               @relation("AssignedLeads", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  agreedPlan             Plan?                       @relation("AgreedLeadPlan", fields: [agreedPlanId], references: [id], onDelete: SetNull)
  partner                Partner?                    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerReferralLink    PartnerReferralLink?        @relation(fields: [partnerReferralLinkId], references: [id], onDelete: SetNull)
  convertedCustomers     CustomerAccount[]           @relation("LeadToCustomer")
  onboardings            CustomerOnboarding[]
  partnerLeadReview      PartnerLeadReview?
  contracts              Contract[]                  @relation("LeadContracts")
  attributedTenants      Tenant[]                    @relation("LeadAttributedTenants")
  attributionCorrections LeadAttributionCorrection[]

  @@index([status, createdAt])
  @@index([subStatus, createdAt])
  @@index([inquiryIntent, createdAt])
  @@index([marketCode, createdAt])
  @@index([workEmail])
  @@index([companyName])
  @@index([source, createdAt])
  @@index([assignedToUserId])
  @@index([partnerId])
  @@index([partnerReferralLinkId])
  @@index([attributionStatus, referredAt])
  @@index([agreedPlanId])
}

model Partner {
