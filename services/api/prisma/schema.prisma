// Publication lifecycle for commercial configuration — plans, prices, markets.
//
// Deliberately separate from `isActive` and from the effectiveFrom/effectiveTo
// pair that already exists on PlanPrice, because they answer different
// questions. Publication is "has this been released for sale"; effectivity is
// "is it in force on this date". A price can be PUBLISHED and not yet
// effective (next quarter's pricing, staged deliberately), and it can be
// ARCHIVED while still being the price a live subscription was sold under.
//
// Before this existed, `isActive` carried both meanings at once, so there was
// no way to prepare a commercial change without it going live the moment it
// was saved.
enum CommercialPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// How a plan or price may be bought. Enterprise is NOT hardcoded to "Contact
// sales" anywhere — a standard published Enterprise plan stays self-service,
// and only configuration moves it to sales-assisted.
enum CommercialSalesModel {
  SELF_SERVICE
  SALES_ASSISTED
  CUSTOM_ONLY
}

// Commercial readiness of a market, tracked separately from whether it is
// enabled. A market can be modelled and priced (PLANNED) long before anyone is
// allowed to buy in it — which is what lets US/GCC exist in configuration
// without implying they are open for business.
enum MarketLaunchStatus {
  PLANNED
  PILOT
  LAUNCHED
  SUSPENDED
}

enum PromotionDuration {
  ONCE
  REPEATING
  FOREVER
}

