  shiftTemplateId                  String?
  officeLocationId                 String?
  importedBatchId                  String?
  date                             DateTime
  checkIn                          DateTime?
  checkOut                         DateTime?
  attendanceMode                   AttendanceMode                @default(OFFICE)
  status                           AttendanceEntryStatus         @default(PRESENT)
  source                           AttendanceEntrySource         @default(SYSTEM)
  checkInSource                    AttendanceEntrySource?
  checkOutSource                   AttendanceEntrySource?
  checkInNote                      String?
  checkOutNote                     String?
  workSummary                      String?
  notes                            String?
  remoteLatitude                   Float?
  remoteLongitude                  Float?
  remoteAddressText                String?
  checkInAddressText               String?
  checkInLatitude                  Float?
  checkInLongitude                 Float?
  checkInLocationAccuracy          Float?
  checkInLocationCapturedAt        DateTime?
  checkOutAddressText              String?
  checkOutLatitude                 Float?
  checkOutLongitude                Float?
  checkOutLocationAccuracy         Float?
  checkOutLocationCapturedAt       DateTime?
  locationLatitude                 Decimal?                      @db.Decimal(10, 7)
  locationLongitude                Decimal?                      @db.Decimal(10, 7)
  locationAccuracyMeters           Int?
  locationSource                   String?
  locationConfidence               String?
  locationCapturedAt               DateTime?
  locationPermissionState          String?
  locationFailureReason            String?
  ipAddress                        String?
  userAgent                        String?
  manualLocationExceptionRequested Boolean                       @default(false)
  manualLocationExceptionReason    String?
  locationPolicySnapshot           Json?
  isLateCheckIn                    Boolean                       @default(false)
  isLateCheckOut                   Boolean                       @default(false)
  lateCheckInMinutes               Int?
  lateCheckOutMinutes              Int?
  machineDeviceId                  String?
  /// Written by the reconciliation engine.
  ///
  /// checkOut - checkIn is not worked time on a day with more than one session:
  /// office 08:05-12:30 plus remote 14:00-18:05 is 8h30m of work, not the 10h
  /// that subtraction would report to timesheets and payroll. Null on legacy rows
  /// the engine has never touched, where the old computation still applies.
  workedMinutes                    Int?
  sessionCount                     Int?
  derivedWorkMode                  EmployeeWorkMode?
  /// True once the engine owns this row. Legacy self-service, manual and imported
  /// rows keep their existing behaviour until the engine reconciles their day.
  reconciled                       Boolean                       @default(false)
  lastReconciledAt                 DateTime?
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt
  createdById                      String?
  updatedById                      String?
  tenant                           Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee                         Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule                     WorkSchedule?                 @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  shiftTemplate                    ShiftTemplate?                @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  officeLocation                   Location?                     @relation("AttendanceOfficeLocation", fields: [officeLocationId], references: [id], onDelete: SetNull)
  importedBatch                    AttendanceImportBatch?        @relation(fields: [importedBatchId], references: [id], onDelete: SetNull)
  correctionRequests               AttendanceCorrectionRequest[]
  attendanceDay                    AttendanceDay?

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([tenantId, shiftTemplateId, date])
  @@index([tenantId, date, status])
  @@index([tenantId, attendanceMode, status, date])
  @@index([tenantId, source, date])
  @@index([tenantId, officeLocationId, date])
  @@index([tenantId, importedBatchId])
}

model AttendanceCorrectionRequest {
  id                     String                     @id @default(uuid())
  tenantId               String
  attendanceEntryId      String?
  employeeId             String
  requestedByUserId      String
  requestNumber          String
  correctionType         AttendanceCorrectionType
  originalCheckInAtUtc   DateTime?
  originalCheckOutAtUtc  DateTime?
  requestedCheckInAtUtc  DateTime?
  requestedCheckOutAtUtc DateTime?
  reason                 String
  attachmentMetadata     Json?
  status                 AttendanceCorrectionStatus @default(SUBMITTED)
  submittedAtUtc         DateTime?
  approvedAtUtc          DateTime?
  rejectedAtUtc          DateTime?
  actionedByUserId       String?
  actionComment          String?
  /// The work day this correction is about.
  ///
  /// Added because a correction for a day with no AttendanceEntry — a wholly
  /// missing day — previously had nowhere to say which day it meant.
  attendanceDate         DateTime?
  requestedWorkMode      EmployeeWorkMode?
  requestedWorkSiteId    String?
  /// Minutes of overtime being approved. Separate from the requested times:
  /// approving overtime does not change WHEN someone worked, it changes whether
  /// time already worked is payable.
  requestedOvertimeMinutes Int?
  /// Set when the request was raised to clear a specific detected exception.
  attendanceExceptionId  String?
  /// An in-office web punch accepted under the fallback policy, rather than an
  /// ordinary unrestricted web punch.
  isWebFallback          Boolean                    @default(false)
  fallbackReason         String?
  createdAtUtc           DateTime                   @default(now())
  updatedAtUtc           DateTime                   @updatedAt
  tenant                 Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceEntry        AttendanceEntry?           @relation(fields: [attendanceEntryId], references: [id], onDelete: SetNull)
