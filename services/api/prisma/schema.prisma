/// A physical place where employees work. The product surfaces this as
/// "Work Site" (see settings/work-sites, which redirects here).
///
/// Attendance-specific configuration lives directly on this model as explicit
/// columns rather than through an inherited override chain: tenant setting
/// overrides in this system are scoped to Organization only (TenantSetting ->
/// OrganizationSetting), so a site-level override has to be modelled explicitly.
/// A null attendance column means "fall back to the tenant setting".
model Location {
  id                       String                       @id @default(uuid())
  tenantId                 String
  name                     String
  code                     String?
  organizationId           String?
  businessUnitId           String?
  addressLine1             String?
  addressLine2             String?
  city                     String
  state                    String
  country                  String
  zipCode                  String?
  timezone                 String?
  latitude                 Float?
  longitude                Float?
  allowedRadiusMeters      Int?
  /// Reject a web/mobile punch whose reported GPS accuracy is worse than this.
  maximumAccuracyMeters    Int?
  /// null = inherit the tenant's Attendance Integration Enabled setting.
  attendanceEnabled        Boolean?
  /// Empty means "inherit the tenant default"; otherwise the allowed methods.
  allowedAttendanceMethods AttendanceMethod[]
  webAttendancePolicy      WorkSiteWebAttendancePolicy?
  devicePolicy             WorkSiteDevicePolicy?
  /// null = inherit the tenant's Web Fallback Policy setting.
  webFallbackEnabled       Boolean?
  validFrom                DateTime?
  validTo                  DateTime?
  /// DEPRECATED as an attendance input.
  ///
  /// A Work Site is a physical place, not a schedule authority: one office holds
  /// teams on different hours and employees on different regional calendars.
  /// Schedule and calendar now resolve down the organizational hierarchy
  /// (Employee -> Team -> Department -> Business Unit -> Organization -> Tenant).
  /// These two columns are retained so existing tenant data is preserved for a
  /// later compatibility review; nothing reads them for attendance resolution.
  defaultWorkScheduleId    String?
  holidayCalendarId        String?
  isActive                 Boolean                      @default(true)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  createdById              String?
  updatedById              String?
  tenant                   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization             Organization?                @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Restrict)
