  type               PartnerType
  // The commercial relationship being proposed. `type` above is the contracting
  // entity type (INDIVIDUAL/COMPANY) and cannot express it, so before Wave 3 a
  // referral partner and a reseller were indistinguishable once submitted.
  partnershipModel   PartnershipModel?
  companyName        String?
  contactFirstName   String
  contactLastName    String
  email              String
  phone              String?
  country            String?
  website            String?
