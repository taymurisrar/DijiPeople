  secondaryColor   String   @default("#115e59")
  accentColor      String?
  backgroundColor  String?
  surfaceColor     String?
  textColor        String?
  mutedTextColor   String?
  fontFamily       String?
  appTitle         String?
  brandName        String?
  shortBrandName   String?
  portalTagline    String?
  loginTitle       String?
  loginSubtitle    String?
  loginFooterText  String?
  supportEmail     String?
  supportPhone     String?
  privacyPolicyUrl String?
