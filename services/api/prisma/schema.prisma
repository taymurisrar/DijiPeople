/// Tenant lifecycle.
///
/// The first seven members are the original set and keep their meaning; the
/// four below them were added when Platform Admin became the tenant control
/// plane and needed to tell "being built" apart from "built but not signed
/// off", and "being retired" apart from "already archived". Nothing rewrites an
/// existing row: a tenant that was ONBOARDING before is still ONBOARDING.
///
///   ONBOARDING          record exists, agreement/commercials not complete
///   PENDING_SETUP       provisioned, tenant-side configuration still required
///   PROVISIONING        a provisioning run is in flight
///   PROVISIONING_FAILED a provisioning run failed and is retryable
///   ACTIVE              live
///   SUSPENDED           reversible platform-imposed block
///   INACTIVE            dormant, no platform block
///   DECOMMISSIONING     retirement in progress
///   DECOMMISSIONED      retired; data still present
///   ARCHIVED / CHURNED  historical terminal states
enum TenantStatus {
  ONBOARDING
  PENDING_SETUP
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
  CHURNED
  PROVISIONING
  PROVISIONING_FAILED
  DECOMMISSIONING
  DECOMMISSIONED
}

enum TenantProvisioningRunStatus {
  RUNNING
