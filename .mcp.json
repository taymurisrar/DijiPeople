{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--viewport-size",
        "1440x900",
        "--console-level",
        "info",
        "--test-id-attribute",
        "data-testid",
        "--snapshot-mode",
        "full",
        "--snapshot-boxes",
        "--caps",
        "vision,devtools,network,storage,testing,config",
        "--codegen",
        "typescript",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "90000",
        "--timeout-settle",
        "800",
        "--image-responses",
        "allow",
        "--output-dir",
        ".playwright-mcp",
        "--output-max-size",
        "104857600",
        "--save-session",
        "--allowed-origins",
        "https://admin.dijipeople.com;https://app.dijipeople.com;https://api.dijipeople.com;https://www.dijipeople.com;https://*.ws.dijipeople.com"
      ]
    }
  }
}