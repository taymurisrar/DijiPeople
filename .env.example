# DijiPeople root environment reference.
# Copy the app-specific example files instead of using this file directly.
# Never commit real secrets. Production DATABASE_URL must be rotated and stored only in Render.

NODE_ENV=development
API_BASE_URL=http://localhost:4000/api
API_ORIGIN=http://localhost:4000
WEB_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
LANDING_APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
STORAGE_PROVIDER=local
# FILE_STORAGE_DIR is used only when STORAGE_PROVIDER=local (development/test).
# Production must use STORAGE_PROVIDER=r2 — the container filesystem is
# ephemeral, so anything written under FILE_STORAGE_DIR there is lost on the
# next deploy.
FILE_STORAGE_DIR=storage/uploads
FILE_UPLOAD_MAX_BYTES=10485760

# Cloudflare R2 (only read when STORAGE_PROVIDER=r2). Never commit real values —
# the live credentials live only on the Render service.
R2_BUCKET_NAME=replace-with-r2-bucket-name
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_REQUEST_TIMEOUT_MS=15000
R2_MAX_ATTEMPTS=3

PLATFORM_SUPER_ADMIN_EMAIL=admin@dijipeople.local
PLATFORM_SUPER_ADMIN_PASSWORD=replace-with-a-strong-12-character-password
ENABLE_DEMO_DATA_RESET=false

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_MODE=test
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3001/settings/subscription/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3001/settings/subscription/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3001/settings/subscription/overview
