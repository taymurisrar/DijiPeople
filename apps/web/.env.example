NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=DijiPeople
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3001
NEXT_PUBLIC_WEB_APP_ORIGIN=http://localhost:3001
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002
NEXT_PUBLIC_LANDING_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_WEB_PROTOCOL=https
NEXT_PUBLIC_COMMON_LOGIN_HOST=app.dijipeople.com
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=
# The domain tenant workspaces are served from. `NEXT_PUBLIC_WEB_ROOT_DOMAIN` is
# the lowest-precedence alias for TENANT_BASE_DOMAIN in
# packages/config/platform-domains.js, so it names the host apps/web itself
# answers on — port 3001 locally.
#
# This said 3000, the LANDING port, while apps/web/.env.local.example said 3001.
# Two committed examples for one app, disagreeing. It never broke anything,
# because `normalizeHostname` strips the port before classification and both
# reduce to `localhost` — which is exactly why it survived: a wrong value that
# nothing reads is a wrong value nobody notices, until the day something reads
# it unnormalised to build a URL. ITEM-0045.
NEXT_PUBLIC_WEB_ROOT_DOMAIN=localhost:3001
NEXT_PUBLIC_ADMIN_ROOT_DOMAIN=localhost:3002

API_BASE_URL=http://localhost:4000/api
API_ORIGIN=http://localhost:4000

ACCESS_TOKEN_COOKIE=web_access_token
REFRESH_TOKEN_COOKIE=web_refresh_token
WEB_ACCESS_TOKEN_COOKIE=web_access_token
WEB_REFRESH_TOKEN_COOKIE=web_refresh_token

SESSION_IDLE_TIMEOUT_SECONDS=28800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
SESSION_REFRESH_THRESHOLD_SECONDS=300

USE_ENTITY_DATA_API=true
EXPOSE_DEV_AUTH_LINKS=true
