NODE_ENV=production
# Arms the production URL validation in packages/config. VERCEL=1 and RENDER=true
# do the same automatically; set this explicitly on any other host.
APP_ENV=production
NEXT_PUBLIC_APP_NAME=DijiPeople
NEXT_PUBLIC_APP_ORIGIN=https://www.dijipeople.com
