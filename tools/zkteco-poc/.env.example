# =========================================================
# DijiPeople — ZKTeco K50 POC device configuration
# Copy to `.env` in this folder and adjust. `.env` is gitignored.
# Every value can also be supplied as a real environment variable
# or as a CLI flag (flags win over env, env wins over defaults).
# =========================================================

# --- Required ---------------------------------------------------------------
ZK_DEVICE_HOST=192.168.18.53

# --- Device -----------------------------------------------------------------
ZK_DEVICE_PORT=4370

# Device / Machine ID. Passed as dwMachineNumber to every SDK call.
ZK_DEVICE_ID=1

# Communication key configured on the device (Menu > Comm > Security > Comm Key).
# 0 means "no key" and is what the reference K50 uses; with 0 the SDK's
# SetCommPassword call is skipped entirely.
ZK_COMM_KEY=0

# Optional. If set, the POC warns when the connected device reports a different
# serial. It never blocks the run.
ZK_EXPECTED_SERIAL=A2QO221160250

# --- Worker -----------------------------------------------------------------
# Path to the x86 worker executable. Relative paths resolve from this folder.
# Defaults to worker/publish/DijiPeople.ZkTeco.Worker.exe.
# ZK_WORKER_PATH=worker/publish/DijiPeople.ZkTeco.Worker.exe

# A full historical attendance download can take minutes on a large device.
ZK_WORKER_TIMEOUT_MS=300000

# --- Reporting --------------------------------------------------------------
# Clock drift above this many seconds is reported as WARNING (POC threshold).
ZK_CLOCK_DRIFT_WARN_SECONDS=60

# Cap on punches written to JSON (most recent kept). 0 = write everything.
ZK_ATTENDANCE_LIMIT=0

# --- Output / logging -------------------------------------------------------
ZK_OUTPUT_DIR=./output
ZK_LOG_LEVEL=info
ZK_LOG_FORMAT=pretty
