    "dev:web": "npm --workspace web run dev",
    "dev:admin": "npm --workspace admin run dev",
    "dev:api": "npm --workspace api run start:dev",
    "bootstrap:admin": "npm --workspace api run seed:admin",
    "release:api": "npm --workspace api run release",
    "release:web": "npm --workspace web run release",
    "release:admin": "npm --workspace admin run release",
    "build": "turbo run build --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run check-types",
    "check-types": "turbo run check-types",
    "generate:runtime-schema": "node scripts/generate-platform-runtime-schema.mjs",
    "test:runtime-schema": "node --test packages/config/platform-runtime-schema.test.js",
