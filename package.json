  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.2.4",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "5.9.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^22"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3"
  },
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "e2e"
  ]
