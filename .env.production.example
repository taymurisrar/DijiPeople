NODE_ENV=production

API_BASE_URL=https://dijipeople.onrender.com/api
API_ORIGIN=https://dijipeople.onrender.com
WEB_APP_URL=https://diji-people-web.vercel.app
ADMIN_APP_URL=https://diji-people-admin.vercel.app
LANDING_APP_URL=https://diji-people-landing.vercel.app
PUBLIC_SITE_URL=https://diji-people-landing.vercel.app
STORAGE_PROVIDER=r2
# FILE_STORAGE_DIR is development-only (STORAGE_PROVIDER=local). Production
# refuses to boot with STORAGE_PROVIDER=local — the container filesystem is
# ephemeral, so it is not set here.
FILE_UPLOAD_MAX_BYTES=10485760

# Cloudflare R2. Never commit real values — the live credentials live only on
# the Render service.
R2_BUCKET_NAME=replace-with-r2-bucket-name
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_REQUEST_TIMEOUT_MS=15000
R2_MAX_ATTEMPTS=3

CORS_ALLOWED_ORIGINS=https://diji-people-admin.vercel.app,https://diji-people-web.vercel.app,https://diji-people-landing.vercel.app
CORS_ALLOW_CREDENTIALS=true

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_MODE=live
STRIPE_CHECKOUT_SUCCESS_URL=https://app.dijipeople.com/settings/subscription/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://app.dijipeople.com/settings/subscription/cancel
STRIPE_PORTAL_RETURN_URL=https://app.dijipeople.com/settings/subscription/overview
